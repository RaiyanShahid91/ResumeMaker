<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.craft.myresume">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />

            <category android:name="android.intent.category.BROWSABLE" />

            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:name=".ads.MyApplication"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ResumeBuilder"
        android:usesCleartextTraffic="true">
        <activity
            android:name="co.resume.register.RegisterActivity"
            android:exported="true" />
        <activity
            android:name="co.resume.login.LoginActivity"
            android:exported="true" />
        <activity
            android:name="co.resume.main.DashboardActivity"
            android:exported="true" />

        <meta-data
            android:name="com.google.android.gms.client_id"
            android:value="@string/default_web_client_id" />

        <meta-data
            android:name="com.google.android.gms.ads.AD_MANAGER_APP"
            android:value="true" />


        <!-- <meta-data -->
        <!-- android:name="applovin.sdk.key" -->
        <!-- android:value="9Mmo8af6r9Ra2RlaxqaPqUD6h8bhmuJpNkThxJR6Vgd7pr03LiTSe7pe9CwCf4l0HrX2f2lTK-P6HrH-RGeIq8" /> -->
        <activity
            android:name="co.resume.welcome.WelcomeScreen"
            android:exported="true"
            android:theme="@style/AppTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".splashAds.FirstPageMainActivity"
            android:exported="true"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".splashAds.AppThankYouActivity"
            android:exported="true"
            android:theme="@style/AppTheme" />
        <activity
            android:name=".splashAds.PrivacyTermsActivity"
            android:exported="true"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.craft.resumebuilder.MainActivity"
            android:exported="true" />
        <activity
            android:name="com.craft.resumebuilder.resume.SignatureActivity"
            android:exported="true" />
        <activity
            android:name="com.craft.resumebuilder.resume.HobbiesActivity"
            android:exported="true" />
        <activity
            android:name="com.craft.resumebuilder.resume.PublishedActivity"
            android:exported="true" />
        <activity
            android:name="com.craft.resumebuilder.HomeActivity"
            android:exported="true" />
        <activity
            android:name="com.craft.resumebuilder.SubscriptionActivity"
            android:exported="true" />
        <activity
            android:name="com.craft.resumebuilder.CheckSubscriptionActivity"
            android:exported="true" />
        <activity
            android:name="com.craft.resumebuilder.resume.ProfilePhotoActivity"
            android:exported="false" />
        <activity
            android:name="com.craft.resumebuilder.resume.SettingsActivity"
            android:exported="true" />
        <activity
            android:name="com.craft.resumebuilder.resume.WebViewActivity"
            android:exported="true" />
        <activity
            android:name="com.craft.resumebuilder.resume.ResumeActivity"
            android:exported="true"
            android:theme="@style/AppTheme" />
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-6654896157338132~1131509067" />
        <meta-data
            android:name="preloaded_fonts"
            android:resource="@array/preloaded_fonts" />
    </application>

</manifest>