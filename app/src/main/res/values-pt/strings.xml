    <string name="about_title">Sobre</string>
    <string name="about_app_name">ResumeAI</string>
    <string name="about_version">Versão %1$s</string>
    <string name="about_tagline">Crie um currículo profissional em minutos, no seu dispositivo.</string>
    <string name="about_what_title">O que é o ResumeAI?</string>
    <string name="about_what_body">O ResumeAI é um aplicativo Android totalmente offline e focado em privacidade que ajuda você a criar currículos elegantes e profissionais do zero. Preencha seus dados, escolha um modelo, personalize a cor de destaque e exporte um PDF pronto para compartilhar — sem conta, sem cadastro, e nenhum dado sai do seu celular.</string>
    <string name="about_features_title">Principais recursos</string>
    <string name="about_feat_personal_title">Dados pessoais</string>
    <string name="about_feat_personal_desc">Nome, cargo, e-mail, telefone e endereço.</string>
    <string name="about_feat_objective_title">Objetivo</string>
    <string name="about_feat_objective_desc">Escreva ou gere com IA um objetivo profissional convincente.</string>
    <string name="about_feat_education_title">Formação</string>
    <string name="about_feat_education_desc">Adicione várias entradas de formação com datas e notas.</string>
    <string name="about_feat_work_title">Experiência profissional</string>
    <string name="about_feat_work_desc">Registre empregos com descrições em tópicos aprimoradas por IA.</string>
    <string name="about_feat_skills_title">Habilidades</string>
    <string name="about_feat_skills_desc">Adicione habilidades manualmente ou deixe a IA sugerir 10 relevantes.</string>
    <string name="about_feat_projects_title">Projetos</string>
    <string name="about_feat_projects_desc">Mostre projetos com links e resumos gerados por IA.</string>
    <string name="about_feat_achievements_title">Conquistas</string>
    <string name="about_feat_achievements_desc">Destaque prêmios e conquistas, com ajuda da IA.</string>
    <string name="about_feat_languages_title">Idiomas e mais</string>
    <string name="about_feat_languages_desc">Idiomas, interesses, hobbies e uma seção de declaração.</string>
    <string name="about_feat_photo_title">Foto de perfil</string>
    <string name="about_feat_photo_desc">Anexe uma foto de perfil e assinatura diretamente da sua câmera ou galeria.</string>
    <string name="about_templates_title">Modelos e design</string>
    <string name="about_templates13_title">13 modelos</string>
    <string name="about_templates13_desc">Clássico, Moderno, Minimalista, Bold, Elegante, Criativo, Duas colunas, Acadêmico, Desenvolvedor, Designer, Portfólio, Professor, Code Dark.</string>
    <string name="about_accent_title">Cor de destaque</string>
    <string name="about_accent_desc">Escolha qualquer cor — ela é aplicada instantaneamente ao cabeçalho, títulos de seção e divisores.</string>
    <string name="about_pdf_title">Exportação em PDF</string>
    <string name="about_pdf_desc">Exporte seu currículo como um PDF de alta qualidade, pronto para enviar a empregadores.</string>
    <string name="about_ai_title">Recursos com tecnologia de IA</string>
    <string name="about_ai_intro">O aplicativo integra um assistente de IA para ajudá-lo a escrever e refinar o conteúdo do currículo. Toque no ícone de brilho ✨ em qualquer seção compatível para gerar ou melhorar o texto instantaneamente.</string>
    <string name="about_ai_objective_title">Gerador de objetivo</string>
    <string name="about_ai_objective_desc">Escreve um objetivo profissional personalizado para o seu cargo.</string>
    <string name="about_ai_job_title">IA de descrição de vaga</string>
    <string name="about_ai_job_desc">Reescreve os tópicos de experiência profissional com verbos de ação fortes.</string>
    <string name="about_ai_skills_title">Sugestões de habilidades</string>
    <string name="about_ai_skills_desc">Sugere 10 habilidades relevantes com base no seu cargo.</string>
    <string name="about_ai_projects_title">Resumos de projetos</string>
    <string name="about_ai_projects_desc">Gera descrições de projeto concisas a partir de apenas um nome de projeto.</string>
    <string name="about_ai_achievements_title">Redator de conquistas</string>
    <string name="about_ai_achievements_desc">Cria declarações de conquistas impactantes e quantificadas.</string>
    <string name="about_ai_chat_title">Assistente de chat com IA</string>
    <string name="about_ai_chat_desc">Chat aberto para fazer brainstorm, redigir ou refinar qualquer parte do seu currículo.</string>
    <string name="about_tech_title">Tecnologia</string>
    <string name="about_tech_built_label">Construído com</string>
    <string name="about_tech_built_value">Kotlin e Jetpack Compose</string>
    <string name="about_tech_ui_label">Kit de interface</string>
    <string name="about_tech_ui_value">Material Design 3</string>
    <string name="about_tech_storage_label">Armazenamento local</string>
    <string name="about_tech_storage_value">Room (SQLite) — todos os dados permanecem no seu dispositivo</string>
    <string name="about_tech_model_label">Modelo de IA</string>
    <string name="about_tech_model_value">Llama 3.1 8B Instant</string>
    <string name="about_tech_provider_label">Provedor de IA</string>
    <string name="about_tech_provider_value">Groq Cloud API (inferência rápida)</string>
    <string name="about_tech_pdf_label">Exportação em PDF</string>
    <string name="about_tech_pdf_value">Android WebView → API de impressão</string>
    <string name="about_privacy_title">Privacidade</string>
    <string name="about_privacy_body">Os dados do seu currículo são armazenados localmente no seu dispositivo usando um banco de dados criptografado. Eles nunca são enviados nem compartilhados com nenhum servidor. O aplicativo só acessa a internet quando você usa um recurso de IA — seu texto é enviado à API do Groq para gerar uma resposta e nada mais é transmitido.</string>
    <string name="about_contact_title">Contato e suporte</string>
    <string name="about_contact_body">Tem alguma dúvida, encontrou um bug ou quer sugerir um recurso? Adoraríamos ouvir de você. Vá em Configurações → Escreva para nós para nos enviar um e-mail.</string>
    <string name="privacy_s1_heading">Sem conta, sem nuvem</string>
    <string name="privacy_s1_body">O ResumeAI funciona inteiramente no seu dispositivo. Não há login, nem conta, nem servidor para onde seus currículos são enviados.</string>
    <string name="privacy_s2_heading">O que é armazenado, e onde</string>
    <string name="privacy_s2_body">Tudo o que você insere — dados pessoais, formação, experiência profissional, habilidades, projetos, fotos e sua assinatura — é salvo apenas no armazenamento privado deste aplicativo no seu dispositivo, nunca enviado a lugar nenhum.</string>
    <string name="privacy_s3_heading">Nada sai do seu dispositivo</string>
    <string name="privacy_s3_body">Não coletamos, transmitimos, vendemos ou compartilhamos os dados do seu currículo com ninguém. Não há análise ou rastreamento do que você digita.</string>
    <string name="privacy_s4_heading">Permissões que solicitamos</string>
    <string name="privacy_s4_body">O acesso à câmera e fotos é usado apenas para que você possa adicionar uma foto de perfil ou imagem de assinatura, e essa imagem é armazenada localmente como o restante do seu currículo.</string>
    <string name="privacy_s5_heading">Excluindo seus dados</string>
    <string name="privacy_s5_body">Excluir um currículo no aplicativo o remove, junto com suas fotos, do seu dispositivo. Desinstalar o aplicativo remove tudo, já que nada é mantido em nenhum outro lugar.</string>
    <string name="guide_s1_title">Criar um currículo</string>
    <string name="guide_s1_desc">Na aba Início ou Meu currículo, toque em \"Criar currículo\" e digite um nome e um cargo.</string>
    <string name="guide_s2_title">Preencha seus dados</string>
    <string name="guide_s2_desc">Abra o currículo e trabalhe em cada seção — Dados pessoais, Objetivo, Formação, Experiência profissional, Habilidades e mais.</string>
    <string name="guide_s3_title">Adicione uma foto ou assinatura</string>
    <string name="guide_s3_desc">Use as seções Foto de perfil e Assinatura para capturar ou escolher uma imagem.</string>
    <string name="guide_s4_title">Escolha um modelo</string>
    <string name="guide_s4_desc">Toque no ícone de paleta para escolher entre vários designs profissionais — trocar de modelo nunca perde os dados que você inseriu.</string>
    <string name="guide_s5_title">Pré-visualize e baixe</string>
    <string name="guide_s5_desc">Toque no ícone de olho para ver exatamente como seu currículo ficará, depois toque no ícone de impressão para salvá-lo como PDF ou imprimi-lo.</string>
    <string name="update_title">Atualização disponível</string>
    <string name="update_body">Uma nova versão do ResumeAI está disponível. Atualize agora para os recursos e correções mais recentes.</string>
    <string name="update_btn">Atualizar agora</string>
