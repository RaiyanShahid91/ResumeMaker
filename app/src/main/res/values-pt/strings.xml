    <string name="onboard_page1_title">Bem-vindo ao ResumeAI</string>
    <string name="onboard_page1_desc">Crie um currículo elegante e profissional diretamente no seu celular — sem necessidade de conta, sem dados saindo do seu dispositivo.</string>
