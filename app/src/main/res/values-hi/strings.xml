    <!-- Home screen -->
    <string name="home_welcome">वापस स्वागत है!</string>
    <string name="home_subtitle">अपना परफेक्ट रेज़्यूमे बनाएं और अपनी सपनों की नौकरी पाएं।</string>
    <string name="home_create_btn">नया रेज़्यूमे बनाएं</string>
    <string name="home_featured_templates">फीचर्ड टेम्पलेट्स</string>
    <string name="home_see_all">सभी देखें</string>
    <string name="home_quick_actions">त्वरित कार्य</string>
    <string name="home_action_create">रेज़्यूमे बनाएं</string>
    <string name="home_action_create_desc">स्क्रैच से नया रेज़्यूमे बनाएं।</string>
    <string name="home_action_resumes">मेरे रेज़्यूमे</string>
    <string name="home_action_resumes_desc">अपने सहेजे गए रेज़्यूमे देखें और प्रबंधित करें।</string>
    <string name="home_action_templates">सभी टेम्पलेट्स</string>
    <string name="home_action_templates_desc">श्रेणी के अनुसार टेम्पलेट्स ब्राउज़ करें।</string>
    <string name="home_tips_title">रेज़्यूमे टिप्स</string>
    <string name="tip_one_page_title">एक पेज पर रहें</string>
    <string name="tip_one_page_body">रिक्रूटर्स रेज़्यूमे पर ~7 सेकंड बिताते हैं। लंबाई नहीं, प्रभाव पर ध्यान दें।</string>
    <string name="tip_quantify_title">उपलब्धियों को मापें</string>
    <string name="tip_quantify_body">संख्याओं का उपयोग करें – \'बिक्री 30% बढ़ाई\' \'बिक्री सुधारी\' से बेहतर है।</string>
    <string name="tip_tailor_title">हर रेज़्यूमे को कस्टमाइज़ करें</string>
    <string name="tip_tailor_body">हर नौकरी के लिए अपना उद्देश्य और कौशल बदलें।</string>
    <string name="tip_verbs_title">क्रिया शब्दों का प्रयोग करें</string>
    <string name="tip_verbs_body">बुलेट पॉइंट क्रियाओं से शुरू करें जैसे नेतृत्व किया, बनाया, डिज़ाइन किया, दिया।</string>
    <string name="tip_skills_title">शीर्ष कौशल उजागर करें</string>
    <string name="tip_skills_body">अपने सबसे मजबूत और प्रासंगिक कौशल शीर्ष पर रखें।</string>
    <string name="home_did_you_know">क्या आप जानते हैं?</string>
    <string name="home_did_you_know_body">75% रेज़्यूमे किसी इंसान द्वारा देखे जाने से पहले ATS द्वारा अस्वीकार कर दिए जाते हैं। साफ़ टेम्पलेट और मेलखाने वाले कीवर्ड का उपयोग मदद करता है।</string>

