<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Adaptive icon safe zone: keep essential content within x:21-87, y:21-87.
        The artwork below is authored edge-to-edge against that safe zone, which reads as too
        zoomed-in once launchers mask it (circle/squircle masks clip right up to the corners of
        that box). The wrapping <group> scales the whole thing down around the canvas center so
        there's real breathing room inside the safe zone instead of touching its edges.
        Scanner viewfinder brackets + document + AI sparkle
    -->
    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.55"
        android:scaleY="0.55">

        <!-- Scanner viewfinder brackets -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.92"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M22,34 L22,22 L34,22" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.92"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M74,22 L86,22 L86,34" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.92"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M22,74 L22,86 L34,86" />
        <path
            android:strokeColor="#FFFFFF"
            android:strokeAlpha="0.92"
            android:strokeWidth="3"
            android:strokeLineCap="round"
            android:pathData="M86,74 L86,86 L74,86" />

        <!-- Document (shadow, body, folded corner, text lines) nudged slightly left of center,
             off the scanner brackets' centerline, since sharing the brackets' exact center made
             it look squeezed up against the AI sparkle on its right. -->
        <group android:translateX="-6">
            <!-- Document shadow -->
            <path
                android:fillColor="#12131A"
                android:fillAlpha="0.18"
                android:pathData="M42,34 L70,34 L77,41 L77,80 L42,80 Z" />

            <!-- Document body -->
            <path
                android:fillColor="#FFFFFF"
                android:pathData="M40,32 L68,32 L75,39 L75,78 L40,78 Z" />

            <!-- Folded corner -->
            <path
                android:fillColor="#D7E3FF"
                android:pathData="M68,32 L75,39 L68,39 Z" />

            <!-- Header line — amber bold -->
            <path
                android:strokeColor="#F5A623"
                android:strokeWidth="2.6"
                android:strokeLineCap="round"
                android:pathData="M46,48 L69,48" />

            <!-- Subtitle line -->
            <path
                android:strokeColor="#AEB8CC"
                android:strokeWidth="1.7"
                android:strokeLineCap="round"
                android:pathData="M46,54 L60,54" />

            <!-- Divider -->
            <path
                android:strokeColor="#E5E7EB"
                android:strokeWidth="0.8"
                android:pathData="M46,59 L69,59" />

            <!-- Content line 1 -->
            <path
                android:strokeColor="#9CA3AF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:pathData="M46,64 L69,64" />

            <!-- Content line 2 (shorter) -->
            <path
                android:strokeColor="#9CA3AF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:pathData="M46,69 L63,69" />

            <!-- Content line 3 -->
            <path
                android:strokeColor="#9CA3AF"
                android:strokeWidth="1.5"
                android:strokeLineCap="round"
                android:pathData="M46,74 L69,74" />
        </group>

        <!-- AI sparkle — 4-pointed star -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M78,54 L79.4,58.4 L83.8,59.8 L79.4,61.2 L78,65.6 L76.6,61.2 L72.2,59.8 L76.6,58.4 Z" />

        <!-- Small accent sparkle -->
        <path
            android:fillColor="#F5A623"
            android:pathData="M83,66 L83.8,68.2 L86,69 L83.8,69.8 L83,72 L82.2,69.8 L80,69 L82.2,68.2 Z" />

    </group>
</vector>
