    <string name="onboard_page1_title">Benvenuto in ResumeAI</string>
    <string name="onboard_page1_desc">Crea un CV curato e professionale direttamente sul tuo telefono — nessun account necessario, nessun dato lascia il tuo dispositivo.</string>
    <string name="onboard_page1_highlight">100% privato e offline</string>
    <string name="onboard_page2_title">Inserisci i tuoi dati</string>
    <string name="onboard_page2_desc">Aggiungi informazioni personali, esperienza lavorativa, istruzione, competenze, progetti, risultati, lingue e altro, tutto in sezioni dedicate.</string>
    <string name="onboard_page2_highlight">13 sezioni del CV</string>
    <string name="onboard_page3_title">Scegli un bel modello</string>
    <string name="onboard_page3_desc">Scegli tra 13 modelli progettati professionalmente — Classico, Moderno, Creativo, Sviluppatore, Designer e molti altri. Personalizza il colore accento in base al tuo stile.</string>
    <string name="onboard_page3_highlight">13 modelli · qualsiasi colore</string>
    <string name="onboard_page4_title">Scrivi in modo più intelligente con l\'IA</string>
    <string name="onboard_page4_desc">Tocca il pulsante scintilla ✨ in Obiettivo, Esperienza lavorativa, Competenze, Progetti o Risultati per generare e migliorare contenuti all\'istante. Oppure apri la Chat IA per una sessione di scrittura completa.</string>
    <string name="onboard_page4_highlight">Offerto da Llama 3.1 tramite Groq</string>
    <string name="onboard_page5_title">Esporta e condividi</string>
    <string name="onboard_page5_desc">Visualizza in anteprima il tuo CV dal vivo, quindi esportalo come PDF di alta qualità o file MS Word (.doc) modificabile — pronto per essere inviato ai datori di lavoro o personalizzato ulteriormente. I tuoi dati sono sempre salvati localmente.</string>
    <string name="onboard_page5_highlight">Export PDF e Word · sempre salvato</string>
    <string name="about_title">Informazioni</string>
    <string name="about_app_name">ResumeAI</string>
    <string name="about_version">Versione %1$s</string>
    <string name="about_tagline">Crea un CV professionale in pochi minuti, sul tuo dispositivo.</string>
    <string name="about_what_title">Cos\'è ResumeAI?</string>
    <string name="about_what_body">ResumeAI è un\'app Android completamente offline e orientata alla privacy che ti aiuta a creare CV curati e professionali da zero. Inserisci i tuoi dati, scegli un modello, personalizza il colore accento ed esporta un PDF pronto da condividere — nessun account, nessuna registrazione, e nessun dato lascia mai il tuo telefono.</string>
    <string name="about_features_title">Funzionalità principali</string>
    <string name="about_feat_personal_title">Dati personali</string>
    <string name="about_feat_personal_desc">Nome, titolo di lavoro, email, telefono e indirizzo.</string>
    <string name="about_feat_objective_title">Obiettivo</string>
    <string name="about_feat_objective_desc">Scrivi o genera con l\'IA un obiettivo di carriera convincente.</string>
    <string name="about_feat_education_title">Istruzione</string>
    <string name="about_feat_education_desc">Aggiungi più voci di istruzione con date e voti.</string>
    <string name="about_feat_work_title">Esperienza lavorativa</string>
    <string name="about_feat_work_desc">Registra i lavori con descrizioni puntate migliorate dall\'IA.</string>
    <string name="about_feat_skills_title">Competenze</string>
    <string name="about_feat_skills_desc">Aggiungi competenze manualmente o lascia che l\'IA ne suggerisca 10 rilevanti.</string>
    <string name="about_feat_projects_title">Progetti</string>
    <string name="about_feat_projects_desc">Mostra progetti con link e riassunti generati dall\'IA.</string>
    <string name="about_feat_achievements_title">Risultati</string>
    <string name="about_feat_achievements_desc">Evidenzia premi e riconoscimenti, con l\'assistenza dell\'IA.</string>
    <string name="about_feat_languages_title">Lingue e altro</string>
    <string name="about_feat_languages_desc">Lingue, interessi, hobby e una sezione dichiarazione.</string>
    <string name="about_feat_photo_title">Foto profilo</string>
    <string name="about_feat_photo_desc">Allega una foto profilo e una firma direttamente dalla fotocamera o dalla galleria.</string>
    <string name="about_templates_title">Modelli e design</string>
    <string name="about_templates13_title">13 modelli</string>
    <string name="about_templates13_desc">Classico, Moderno, Minimale, Bold, Elegante, Creativo, Due colonne, Accademico, Sviluppatore, Designer, Portfolio, Docente, Code Dark.</string>
    <string name="about_accent_title">Colore accento</string>
    <string name="about_accent_desc">Scegli qualsiasi colore — si applica istantaneamente a intestazione, titoli di sezione e divisori.</string>
    <string name="about_pdf_title">Esportazione PDF</string>
    <string name="about_pdf_desc">Esporta il tuo CV come PDF di alta qualità, pronto per essere inviato ai datori di lavoro.</string>
    <string name="about_ai_title">Funzionalità basate sull\'IA</string>
    <string name="about_ai_intro">L\'app integra un assistente IA per aiutarti a scrivere e perfezionare i contenuti del CV. Tocca l\'icona scintilla ✨ in qualsiasi sezione supportata per generare o migliorare il testo all\'istante.</string>
    <string name="about_ai_objective_title">Generatore di obiettivi</string>
    <string name="about_ai_objective_desc">Scrive un obiettivo di carriera professionale su misura per il tuo titolo di lavoro.</string>
    <string name="about_ai_job_title">IA per descrizioni di lavoro</string>
    <string name="about_ai_job_desc">Riscrive i punti dell\'esperienza lavorativa con verbi d\'azione incisivi.</string>
    <string name="about_ai_skills_title">Suggerimenti competenze</string>
    <string name="about_ai_skills_desc">Suggerisce 10 competenze rilevanti in base al tuo ruolo lavorativo.</string>
    <string name="about_ai_projects_title">Riassunti dei progetti</string>
    <string name="about_ai_projects_desc">Genera descrizioni di progetto concise a partire solo dal nome del progetto.</string>
    <string name="about_ai_achievements_title">Redattore di risultati</string>
    <string name="about_ai_achievements_desc">Crea dichiarazioni di risultati d\'impatto e quantificate.</string>
    <string name="about_ai_chat_title">Assistente chat IA</string>
    <string name="about_ai_chat_desc">Chat aperta per fare brainstorming, redigere o perfezionare qualsiasi parte del tuo CV.</string>
