    <string name="onboard_page1_title">Willkommen bei ResumeAI</string>
    <string name="onboard_page1_desc">Erstelle einen professionellen Lebenslauf direkt auf deinem Handy — kein Konto nötig, keine Daten verlassen dein Gerät.</string>
    <string name="onboard_page1_highlight">100% privat &amp; offline</string>
    <string name="onboard_page2_title">Gib deine Daten ein</string>
    <string name="onboard_page2_desc">Füge persönliche Angaben, Berufserfahrung, Ausbildung, Fähigkeiten, Projekte, Erfolge, Sprachen und mehr in eigenen Abschnitten hinzu.</string>
    <string name="onboard_page2_highlight">13 Lebenslaufabschnitte</string>
    <string name="onboard_page3_title">Wähle eine schöne Vorlage</string>
    <string name="onboard_page3_desc">Wähle aus 13 professionell gestalteten Vorlagen — Klassisch, Modern, Kreativ, Entwickler, Designer und viele mehr. Passe die Akzentfarbe an deinen Stil an.</string>
    <string name="onboard_page3_highlight">13 Vorlagen · jede Farbe</string>
    <string name="onboard_page4_title">Schreibe klüger mit KI</string>
    <string name="onboard_page4_desc">Tippe auf die ✨-Schaltfläche in Ziel, Berufserfahrung, Fähigkeiten, Projekten oder Erfolgen, um Inhalte sofort zu erstellen und zu verbessern. Oder öffne den KI-Chat für eine vollständige Schreibsitzung.</string>
    <string name="onboard_page4_highlight">Unterstützt von Llama 3.1 über Groq</string>
    <string name="onboard_page5_title">Exportieren &amp; Teilen</string>
    <string name="onboard_page5_desc">Sieh dir eine Live-Vorschau deines Lebenslaufs an und exportiere ihn dann als hochwertige PDF- oder bearbeitbare MS-Word-Datei (.doc) — bereit für Arbeitgeber oder weitere Anpassungen. Deine Daten werden immer lokal gespeichert.</string>
    <string name="onboard_page5_highlight">PDF- &amp; Word-Export · immer gespeichert</string>
    <string name="about_title">Über</string>
    <string name="about_app_name">ResumeAI</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_tagline">Erstelle einen professionellen Lebenslauf in Minuten, auf deinem Gerät.</string>
    <string name="about_what_title">Was ist ResumeAI?</string>
    <string name="about_what_body">ResumeAI ist eine vollständig offline nutzbare, datenschutzorientierte Android-App, mit der du von Grund auf professionelle Lebensläufe erstellen kannst. Gib deine Daten ein, wähle eine Vorlage, passe die Akzentfarbe an und exportiere eine teilbare PDF — kein Konto, keine Anmeldung, und keine Daten verlassen dein Handy.</string>
    <string name="about_features_title">Kernfunktionen</string>
    <string name="about_feat_personal_title">Persönliche Daten</string>
    <string name="about_feat_personal_desc">Name, Berufsbezeichnung, E-Mail, Telefon und Adresse.</string>
    <string name="about_feat_objective_title">Ziel</string>
    <string name="about_feat_objective_desc">Schreibe selbst oder lass ein überzeugendes Berufsziel per KI generieren.</string>
    <string name="about_feat_education_title">Ausbildung</string>
    <string name="about_feat_education_desc">Füge mehrere Ausbildungseinträge mit Daten und Noten hinzu.</string>
    <string name="about_feat_work_title">Berufserfahrung</string>
    <string name="about_feat_work_desc">Erfasse Jobs mit KI-verbesserten Stichpunktbeschreibungen.</string>
    <string name="about_feat_skills_title">Fähigkeiten</string>
    <string name="about_feat_skills_desc">Füge Fähigkeiten manuell hinzu oder lass dir per KI 10 passende vorschlagen.</string>
    <string name="about_feat_projects_title">Projekte</string>
    <string name="about_feat_projects_desc">Präsentiere Projekte mit Links und KI-generierten Zusammenfassungen.</string>
    <string name="about_feat_achievements_title">Erfolge</string>
    <string name="about_feat_achievements_desc">Hebe Auszeichnungen und Erfolge hervor, KI-unterstützt.</string>
    <string name="about_feat_languages_title">Sprachen &amp; mehr</string>
    <string name="about_feat_languages_desc">Sprachen, Interessen, Hobbys und ein Erklärungsabschnitt.</string>
    <string name="about_feat_photo_title">Profilfoto</string>
    <string name="about_feat_photo_desc">Füge ein Profilfoto und eine Unterschrift direkt aus deiner Kamera oder Galerie hinzu.</string>
    <string name="about_templates_title">Vorlagen &amp; Design</string>
    <string name="about_templates13_title">13 Vorlagen</string>
    <string name="about_templates13_desc">Klassisch, Modern, Minimal, Bold, Elegant, Kreativ, Zweispaltig, Akademisch, Entwickler, Designer, Portfolio, Lehrer, Code Dark.</string>
    <string name="about_accent_title">Akzentfarbe</string>
    <string name="about_accent_desc">Wähle jede Farbe — sie wird sofort auf Kopfzeile, Abschnittstitel und Trennlinien angewendet.</string>
    <string name="about_pdf_title">PDF-Export</string>
    <string name="about_pdf_desc">Exportiere deinen Lebenslauf als hochwertige PDF, bereit für Arbeitgeber.</string>
    <string name="about_ai_title">KI-gestützte Funktionen</string>
    <string name="about_ai_intro">Die App integriert einen KI-Assistenten, der dir beim Schreiben und Verfeinern von Lebenslaufinhalten hilft. Tippe auf das ✨-Symbol in jedem unterstützten Abschnitt, um Text sofort zu erstellen oder zu verbessern.</string>
    <string name="about_ai_objective_title">Zielgenerator</string>
    <string name="about_ai_objective_desc">Schreibt ein professionelles Berufsziel, zugeschnitten auf deine Berufsbezeichnung.</string>
    <string name="about_ai_job_title">Stellenbeschreibungs-KI</string>
    <string name="about_ai_job_desc">Formuliert Stichpunkte zur Berufserfahrung mit starken Aktionsverben neu.</string>
    <string name="about_ai_skills_title">Fähigkeitsvorschläge</string>
    <string name="about_ai_skills_desc">Schlägt 10 passende Fähigkeiten basierend auf deiner Berufsbezeichnung vor.</string>
    <string name="about_ai_projects_title">Projektzusammenfassungen</string>
    <string name="about_ai_projects_desc">Erstellt prägnante Projektbeschreibungen aus nur einem Projektnamen.</string>
    <string name="about_ai_achievements_title">Erfolgs-Autor</string>
    <string name="about_ai_achievements_desc">Formuliert wirkungsvolle, quantifizierte Erfolgsaussagen.</string>
    <string name="about_ai_chat_title">KI-Chat-Assistent</string>
    <string name="about_ai_chat_desc">Offener Chat zum Brainstormen, Entwerfen oder Verfeinern jedes Teils deines Lebenslaufs.</string>
    <string name="about_tech_title">Technologie</string>
