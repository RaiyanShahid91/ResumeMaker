<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardCornerRadius="10dp">
    <LinearLayout android:orientation="vertical" android:padding="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
                <TextView android:textSize="18sp" android:textColor="@color/black" android:id="@+id/textview_hobby_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Playing video games"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
            <Button android:textSize="14sp" android:textColor="@color/white" android:id="@+id/button_edit_details" android:background="@drawable/button_ripple_effect" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="2.5dp" android:text="Edit" android:layout_weight="2" app:backgroundTint="@null"/>
            <Button android:textSize="14sp" android:textColor="@color/white" android:id="@+id/button_delete" android:background="@drawable/button_ripple_effect" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="2.5dp" android:text="Delete" android:layout_weight="2" app:backgroundTint="@color/tomato"/>
            <Button android:textSize="18sp" android:textColor="@color/white" android:id="@+id/button_move_up" android:background="@drawable/button_ripple_effect" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="2.5dp" android:text="↑" android:layout_weight="1" app:backgroundTint="@color/gray"/>
            <Button android:textSize="18sp" android:textColor="@color/white" android:id="@+id/button_move_down" android:background="@drawable/button_ripple_effect" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="2.5dp" android:text="↓" android:layout_weight="1" app:backgroundTint="@color/gray"/>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
