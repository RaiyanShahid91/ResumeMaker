<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:orientation="vertical" android:background="@drawable/gradient" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <ProgressBar android:id="@+id/progress" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_marginTop="-3dp" android:progress="20" style="?android:attr/progressBarStyleHorizontal"/>
            <TextView android:textSize="28sp" android:textStyle="bold" android:textColor="@color/white" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:layout_marginBottom="20dp" android:text="��  Publish Resume" android:layout_marginStart="20dp"/>
            <TextView android:textSize="16sp" android:textColor="@color/white" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="30dp" android:text="Resume Status :"/>
            <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/white" android:gravity="center" android:id="@+id/textview_resume_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:text=""/>
            <TextView android:textSize="16sp" android:textColor="@color/white" android:gravity="center" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Resume Link :"/>
            <TextView android:textSize="20sp" android:textStyle="bold" android:textColor="@color/white" android:gravity="center" android:id="@+id/textview_resume_address" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="-----"/>
            <LinearLayout android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="20dp">
                <Button android:textSize="16sp" android:textStyle="bold" android:textColor="@color/dodgerblue" android:id="@+id/button_visit_link" android:background="@drawable/button_ripple_effect" android:padding="12.5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" android:text="Visit Link" android:drawableLeft="@drawable/ic_baseline_remove_red_eye_24" android:textAllCaps="false" android:drawableTint="@color/dodgerblue" app:backgroundTint="@color/white"/>
                <Button android:textSize="16sp" android:textStyle="bold" android:textColor="@color/dodgerblue" android:id="@+id/button_share_link" android:background="@drawable/button_ripple_effect" android:padding="12.5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" android:text="Share Link" android:drawableLeft="@drawable/ic_baseline_share_24" android:textAllCaps="false" android:drawableTint="@color/dodgerblue" app:backgroundTint="@color/white"/>
                <Button android:textSize="16sp" android:textStyle="bold" android:textColor="@color/dodgerblue" android:id="@+id/button_unpublish_resume" android:background="@drawable/button_ripple_effect" android:padding="12.5dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="5dp" android:text="Unpublish Resume" android:drawableLeft="@drawable/ic_baseline_remove_circle_24" android:textAllCaps="false" android:drawableTint="@color/dodgerblue" app:backgroundTint="@color/white"/>
                <TextView android:textSize="16sp" android:textColor="@color/white" android:id="@+id/textview_publishing_instructions" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/string_resume_publishing_instructions"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
