<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="co.resume.register.RegisterActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <TextView
            android:id="@+id/skip_login"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_20"
            android:gravity="center"
            android:padding="@dimen/dp_7"
            android:text="@string/skip"
            android:textColor="@color/colorGrey"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toTopOf="@+id/lottieAnimationView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieAnimationView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_250"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_50"
            android:layout_marginEnd="@dimen/dp_20"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/register" />

        <TextView
            android:id="@+id/login_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_10"
            android:fontFamily="@font/avenirltstd_medium"
            android:text="@string/sign_up"
            android:textColor="@color/black"
            android:textSize="@dimen/sp_30"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="@+id/lottieAnimationView"
            app:layout_constraintTop_toBottomOf="@+id/lottieAnimationView" />


        <ImageView
            android:id="@+id/img_email"
            android:layout_width="@dimen/dp_25"
            android:layout_height="@dimen/dp_25"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_30"
            android:src="@drawable/ic_at_the_rate"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/login_label"
            app:tint="@color/colorAccent" />

        <EditText
            android:id="@+id/et_email"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_20"
            android:fontFamily="@font/avenirltstd_medium"
            android:hint="@string/email_id"
            android:maxLength="80"
            android:maxLines="1"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@+id/img_email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_email"
            app:layout_constraintTop_toTopOf="@+id/img_email" />

        <ImageView
            android:id="@+id/img_name"
            android:layout_width="@dimen/dp_25"
            android:layout_height="@dimen/dp_25"
            android:layout_marginTop="@dimen/dp_30"
            android:src="@drawable/user"
            app:layout_constraintEnd_toEndOf="@+id/img_email"
            app:layout_constraintStart_toStartOf="@+id/img_email"
            app:layout_constraintTop_toBottomOf="@+id/et_email"
            app:tint="@color/colorAccent" />

        <EditText
            android:id="@+id/et_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_20"
            android:fontFamily="@font/avenirltstd_medium"
            android:hint="@string/name"
            android:maxLength="80"
            android:maxLines="1"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@+id/img_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_name"
            app:layout_constraintTop_toTopOf="@+id/img_name" />

        <ImageView
            android:id="@+id/img_password"
            android:layout_width="@dimen/dp_25"
            android:layout_height="@dimen/dp_25"
            android:layout_marginTop="@dimen/dp_30"
            android:src="@drawable/ic_locked"
            app:layout_constraintEnd_toEndOf="@+id/img_name"
            app:layout_constraintStart_toStartOf="@+id/img_name"
            app:layout_constraintTop_toBottomOf="@+id/et_name"
            app:tint="@color/colorAccent" />

        <EditText
            android:id="@+id/et_password"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/dp_10"
            android:layout_marginEnd="@dimen/dp_20"
            android:fontFamily="@font/avenirltstd_medium"
            android:hint="@string/password"
            android:maxLength="80"
            android:maxLines="1"
            android:textSize="@dimen/sp_14"
            app:layout_constraintBottom_toBottomOf="@+id/img_password"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/img_password"
            app:layout_constraintTop_toTopOf="@+id/img_password" />

        <TextView
            android:id="@+id/term_txt"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:fontFamily="@font/avenirltstd_medium"
            android:text="@string/accept_term_condition"
            android:textAllCaps="false"
            android:padding="@dimen/dp_10"
            android:textColor="@color/colorAccent"
            android:textSize="@dimen/sp_14"
            android:gravity="center"
            app:layout_constraintEnd_toEndOf="@+id/et_password"
            app:layout_constraintStart_toStartOf="@+id/img_password"
            app:layout_constraintTop_toBottomOf="@+id/et_password" />


        <Button
            android:id="@+id/register_Continue"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:background="@drawable/button_background"
            android:enabled="false"
            android:paddingTop="@dimen/dp_10"
            android:paddingBottom="@dimen/dp_10"
            android:fontFamily="@font/abyssinica_sil"
            android:text="@string/_continue"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_14"
            app:layout_constraintEnd_toEndOf="@+id/term_txt"
            app:layout_constraintStart_toStartOf="@+id/term_txt"
            app:layout_constraintTop_toBottomOf="@+id/term_txt" />


        <TextView
            android:id="@+id/or_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:fontFamily="@font/avenirltstd_medium"
            android:text="@string/or"
            android:textAllCaps="false"
            android:textColor="@color/light_grey"
            android:textSize="@dimen/sp_16"
            app:layout_constraintEnd_toEndOf="@+id/register_Continue"
            app:layout_constraintStart_toStartOf="@+id/register_Continue"
            app:layout_constraintTop_toBottomOf="@+id/register_Continue" />

        <Button
            android:id="@+id/iv_google"
            android:layout_width="@dimen/dp_0"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginBottom="@dimen/dp_40"
            android:background="@drawable/google_background"
            android:drawableStart="@drawable/ic_google"
            android:fontFamily="@font/abyssinica_sil"
            android:padding="@dimen/dp_10"
            android:scaleType="centerCrop"
            android:text="@string/continue_with_google"
            android:textAllCaps="false"
            android:textColor="@color/gray"
            app:layout_constraintEnd_toEndOf="@+id/register_Continue"
            app:layout_constraintStart_toStartOf="@+id/register_Continue"
            app:layout_constraintTop_toBottomOf="@+id/or_label" />

        <LinearLayout
            android:id="@+id/ll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_marginTop="@dimen/dp_30"
            android:layout_marginBottom="@dimen/dp_20"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/iv_google"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/txt_login_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/avenirltstd_medium"
                android:text="@string/joined_us_before"
                android:textColor="@color/light_grey"
                android:textSize="@dimen/sp_14" />

            <TextView
                android:id="@+id/txt_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/dp_10"
                android:fontFamily="@font/avenirltstd_medium"
                android:text="@string/login"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
