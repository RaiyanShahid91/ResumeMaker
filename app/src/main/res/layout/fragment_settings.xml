<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="co.resume.fragment.SettingsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_15"
            android:layout_marginEnd="@dimen/dp_20">

            <TextView
                android:id="@+id/login_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/profile"
                android:textColor="@color/gray"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/my_account_img"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/user"
                app:layout_constraintBottom_toBottomOf="@+id/my_account_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/my_account_label"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/my_account_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="@string/my_account"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/my_account_img"
                app:layout_constraintTop_toBottomOf="@+id/login_label" />

            <TextView
                android:id="@+id/login_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/gray"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/my_account_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/my_account_label"
                tools:text="raiyanshahid41@gmail.com" />

            <ImageView
                android:id="@+id/language_img"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/ic_language"
                app:layout_constraintBottom_toBottomOf="@+id/langauge_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/langauge_label"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/langauge_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="@string/languages"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/language_img"
                app:layout_constraintTop_toBottomOf="@+id/my_account_label" />

            <ImageView
                android:id="@+id/pw_img"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/ic_locked"
                app:layout_constraintBottom_toBottomOf="@+id/change_password_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/change_password_label"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/change_password_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="@string/change_password"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/pw_img"
                app:layout_constraintTop_toBottomOf="@+id/langauge_label" />

            <ImageView
                android:id="@+id/password_forward_img"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_forward"
                app:layout_constraintBottom_toBottomOf="@+id/change_password_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/change_password_label"
                app:tint="@color/gray" />

            <ImageView
                android:id="@+id/logout_img"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/ic_logout"
                app:layout_constraintBottom_toBottomOf="@+id/logout_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/logout_label"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/logout_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="@string/logout"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/logout_img"
                app:layout_constraintTop_toBottomOf="@+id/change_password_label" />

            <ImageView
                android:id="@+id/logout_forward_img"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_forward"
                app:layout_constraintBottom_toBottomOf="@+id/logout_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/logout_label"
                app:tint="@color/gray" />

            <ImageView
                android:id="@+id/deleteImg"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/baseline_delete_24"
                app:layout_constraintBottom_toBottomOf="@+id/delete_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/delete_label"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/delete_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="@string/delete_account"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/deleteImg"
                app:layout_constraintTop_toBottomOf="@+id/logout_label" />

            <ImageView
                android:id="@+id/delete_forward_img"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_forward"
                app:layout_constraintBottom_toBottomOf="@+id/delete_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/delete_label"
                app:tint="@color/gray" />

            <TextView
                android:id="@+id/selectedLanguage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_15"
                android:padding="@dimen/dp_10"
                android:text="@string/english"
                android:textColor="@color/gray"
                android:textSize="@dimen/sp_14"
                app:layout_constraintBottom_toBottomOf="@+id/langauge_txt"
                app:layout_constraintEnd_toStartOf="@+id/langauge_txt"
                app:layout_constraintTop_toTopOf="@+id/langauge_txt" />

            <Spinner
                android:id="@+id/langauge_txt"
                android:layout_width="@dimen/dp_30"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/dp_5"
                android:padding="@dimen/dp_5"
                app:layout_constraintBottom_toBottomOf="@+id/langauge_label"
                app:layout_constraintEnd_toStartOf="@+id/langauge_change"
                app:layout_constraintTop_toTopOf="@+id/langauge_label" />

            <ImageView
                android:id="@+id/langauge_change"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_forward"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/langauge_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/langauge_label"
                app:tint="@color/gray" />

            <View
                android:id="@+id/view_1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_20"
                android:background="@color/lightgray"
                app:layout_constraintBottom_toTopOf="@+id/term_privacy_label"
                app:layout_constraintTop_toBottomOf="@+id/delete_label" />


            <TextView
                android:id="@+id/term_privacy_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="@string/term_and_privacy"
                android:textColor="@color/gray"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_1" />

            <ImageView
                android:id="@+id/term_img"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/ic_term"
                app:layout_constraintBottom_toBottomOf="@+id/term_of_use_lable"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/term_of_use_lable"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/term_of_use_lable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="@string/term_of_use"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/term_img"
                app:layout_constraintTop_toBottomOf="@+id/term_privacy_label" />

            <ImageView
                android:id="@+id/term_of_use_forward"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_forward"
                app:layout_constraintBottom_toBottomOf="@+id/term_of_use_lable"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/term_of_use_lable"
                app:tint="@color/gray" />

            <ImageView
                android:id="@+id/privacy_img"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/ic_term"
                app:layout_constraintBottom_toBottomOf="@+id/privacy_lable"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/privacy_lable"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/privacy_lable"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="@string/term_of_privacy"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/term_img"
                app:layout_constraintTop_toBottomOf="@+id/term_of_use_lable" />

            <ImageView
                android:id="@+id/privacy_forward"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_forward"
                app:layout_constraintBottom_toBottomOf="@+id/privacy_lable"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/privacy_lable"
                app:tint="@color/gray" />


            <View
                android:id="@+id/view_2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_1"
                android:layout_marginTop="@dimen/dp_20"
                android:background="@color/lightgray"
                app:layout_constraintTop_toBottomOf="@+id/privacy_lable" />

            <TextView
                android:id="@+id/contact_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_20"
                android:text="Contact"
                android:textColor="@color/gray"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/view_2" />


            <ImageView
                android:id="@+id/rate_img"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/star"
                app:layout_constraintBottom_toBottomOf="@+id/rate_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rate_label"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/rate_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="@string/rate_our_app"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/rate_img"
                app:layout_constraintTop_toBottomOf="@+id/contact_label" />

            <ImageView
                android:id="@+id/rate_forward"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_forward"
                app:layout_constraintBottom_toBottomOf="@+id/rate_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/rate_label"
                app:tint="@color/gray" />

            <ImageView
                android:id="@+id/write_mail_img"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/email"
                app:layout_constraintBottom_toBottomOf="@+id/write_email_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/write_email_label"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/write_email_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="@string/write_us_on"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@+id/write_mail_img"
                app:layout_constraintTop_toBottomOf="@+id/rate_label" />

            <ImageView
                android:id="@+id/write_mail_forward"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_forward"
                app:layout_constraintBottom_toBottomOf="@+id/write_email_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/write_email_label"
                app:tint="@color/gray" />

            <ImageView
                android:id="@+id/help_support_img"
                android:layout_width="@dimen/dp_25"
                android:layout_height="@dimen/dp_25"
                android:src="@drawable/ic_help"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/help_support_label"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/help_support_label"
                app:tint="@color/colorAccent" />

            <TextView
                android:id="@+id/help_support_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_15"
                android:padding="@dimen/dp_15"
                android:text="Help &amp; support"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_14"
                android:textStyle="bold"
                android:visibility="gone"
                app:layout_constraintStart_toEndOf="@+id/help_support_img"
                app:layout_constraintTop_toBottomOf="@+id/write_email_label" />

            <ImageView
                android:id="@+id/help_support_forward"
                android:layout_width="@dimen/dp_10"
                android:layout_height="@dimen/dp_20"
                android:src="@drawable/ic_forward"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/help_support_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/help_support_label"
                app:tint="@color/gray" />


            <TextView
                android:id="@+id/app_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_45"
                android:padding="@dimen/dp_15"
                android:textColor="@color/colorAccent"
                android:textSize="@dimen/sp_13"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/help_support_label"
                tools:text="App version 0.01" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

</FrameLayout>