<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:aapt="http://schemas.android.com/aapt" android:background="@color/white" android:layout_width="match_parent" android:layout_height="match_parent">
    <ScrollView android:layout_width="match_parent" android:layout_height="wrap_content">
        <LinearLayout android:orientation="vertical" android:padding="20dp" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:textSize="18sp" android:textStyle="bold" android:textColor="@color/dodgerblue" android:layout_gravity="center" android:background="@null" android:paddingLeft="20dp" android:paddingTop="10dp" android:paddingRight="20dp" android:paddingBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="��  Hobbies" app:backgroundTint="@color/white"/>
            <TextView android:textSize="14sp" android:textColor="@color/dodgerblue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Hobby :"/>
            <EditText android:textSize="18sp" android:id="@+id/edittext_hobby_name" android:background="@drawable/edittext_focused_effect" android:padding="15dp" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:hint="Reading books" android:maxLength="200" android:inputType="textCapSentences" android:textCursorDrawable="@drawable/custom_cursor"/>
            <Button android:textSize="14sp" android:textStyle="bold" android:textColor="@color/white" android:layout_gravity="center" android:id="@+id/button_save_details" android:background="@drawable/button_ripple_effect" android:paddingLeft="50dp" android:paddingTop="10dp" android:paddingRight="50dp" android:paddingBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="35dp" android:text="Save Details" app:backgroundTint="@null"/>
            <Button android:textSize="14sp" android:textStyle="bold" android:textColor="@color/dodgerblue" android:layout_gravity="center" android:id="@+id/button_cancel" android:background="@android:color/transparent" android:paddingLeft="50dp" android:paddingTop="10dp" android:paddingRight="50dp" android:paddingBottom="10dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cancel"/>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
