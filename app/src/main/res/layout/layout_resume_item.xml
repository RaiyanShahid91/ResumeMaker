<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/dp_5">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/dp_5"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/dp_15"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/dp_10">

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/resume_image"
                android:layout_width="@dimen/dp_70"
                android:layout_height="@dimen/dp_70"
                android:layout_margin="@dimen/dp_5"
                android:src="@drawable/ic_new_resume_icon"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/main_details_layout"
                android:layout_width="@dimen/dp_0"
                android:layout_height="@dimen/dp_70"
                android:layout_marginStart="@dimen/dp_10"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="@+id/resume_image"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/resume_image"
                app:layout_constraintTop_toTopOf="@+id/resume_image">


                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/resume_name"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_40"
                        android:maxLength="80"
                        android:textColor="@color/black"
                        android:textSize="@dimen/dp_15"
                        android:textStyle="bold"
                        tools:text="Mohit Kumar" />

                    <TextView
                        android:id="@+id/resume_designation"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_30"
                        android:maxLength="100"
                        android:gravity="start|bottom"
                        android:textColor="@color/black1"
                        android:textSize="@dimen/sp_14"
                        android:textStyle="bold"
                        tools:text="Description" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/delete_resume"
                        android:layout_width="@dimen/dp_25"
                        android:layout_height="@dimen/dp_25"
                        android:layout_margin="@dimen/dp_5"
                        android:layout_gravity="end"
                        android:src="@drawable/baseline_delete_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/red" />

                    <TextView
                        android:id="@+id/resume_date"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/dp_35"
                        android:gravity="end|bottom"
                        android:maxLength="100"
                        android:textColor="@color/gray"
                        android:textSize="@dimen/sp_12"
                        android:textStyle="bold"
                        tools:text="12 May 2024" />

                </LinearLayout>

            </LinearLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>